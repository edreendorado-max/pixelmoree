<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor)(?:/|$) - [F,END,NC]
    RewriteRule ^(?:\.env(?:\..*)?|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|README\.md|.*\.sql)$ - [F,END,NC]
    RewriteRule ^public(?:/|$) - [END]
    RewriteRule ^(.*)$ public/$1 [END]
</IfModule>
