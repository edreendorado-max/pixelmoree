APP_NAME=Pixmoree
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

PAYMENTS_PHP_PER_ETH=200000
PAYMENTS_PHP_PER_USD=58
PIXEL_COIN_PER_PHP=100
PAYMENTS_ENABLED=false
GCASH_PAYMENT_INSTRUCTIONS=
MAYA_PAYMENT_INSTRUCTIONS=
PAYPAL_PAYMENT_INSTRUCTIONS=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pixmoreedb
DB_USERNAME=root
DB_PASSWORD=

# Optional values used only by the local pixmoree:reset-accounts command.
PIXMOREE_ADMIN_NAME=
PIXMOREE_ADMIN_EMAIL=
PIXMOREE_ADMIN_USERNAME=
PIXMOREE_ADMIN_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
