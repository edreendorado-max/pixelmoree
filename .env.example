APP_NAME=Pixmoree
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"


PAYMENTS_PHP_PER_ETH=200000
PAYMENTS_ENABLED=false
PIXEL_COIN_TOPUP_NUMERATOR=5
PIXEL_COIN_TOPUP_DENOMINATOR=6
PIXEL_COIN_TOPUP_FEE_PERCENT=1.5
PIXEL_COIN_PAYOUT_PHP_PER_COIN=1.2
PIXEL_COIN_MIN_TOPUP_PHP=20
PIXEL_COIN_MIN_WITHDRAWAL=200

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pixmoreedb
DB_USERNAME=root
DB_PASSWORD=
DB_FOREIGN_KEYS=true

# Optional values used only by the local pixmoree:reset-accounts command.
PIXMOREE_ADMIN_NAME=
PIXMOREE_ADMIN_EMAIL=
PIXMOREE_ADMIN_USERNAME=
PIXMOREE_ADMIN_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
